DATABASE_URL=postgres://auction:auction@localhost:5433/auction_engine_test
PORT=3001
# Unset (127.0.0.1) is correct for local dev. A container needs 0.0.0.0 to
# accept connections from outside its own network namespace — see
# infra/k8s/api.yaml, which sets this explicitly.
# HOST=0.0.0.0

# How often (ms) the in-process scheduler checks for bidding windows that
# have closed. See src/scheduler.ts.
# SCHEDULER_INTERVAL_MS=3000

# Internal-only URL of the web rebuilder sidecar's POST /rebuild endpoint
# (see infra/k8s/web.yaml). Left unset in dev/test — there is no static site
# to regenerate outside a deployment. Set only in production.
# WEB_REBUILD_URL=http://oneabobeall-web-rebuild.oneabobeall.svc.cluster.local/rebuild

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
CORS_ORIGIN=http://127.0.0.1:4321
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
APPLE_TEAM_ID=...
APPLE_KEY_ID=...
APPLE_SERVICES_ID=...
APPLE_PRIVATE_KEY_PATH=./apple-private-key.p8
PUBLIC_APP_URL=http://127.0.0.1:4321
API_PUBLIC_URL=http://127.0.0.1:3001

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AccountShell from "../../components/AccountShell";
import LeaderboardTable from "../../components/LeaderboardTable";

const apiBaseUrl = import.meta.env.API_BASE_URL ?? "http://127.0.0.1:3001";
---
<BaseLayout title="oneabobeall — Leaderboard">
  <AccountShell client:load apiBaseUrl={apiBaseUrl}>
    <LeaderboardTable client:load apiBaseUrl={apiBaseUrl} />
  </AccountShell>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import AuctionFlow from "../components/AuctionFlow";
import { adaptScene, adaptLeaderboardRow } from "../lib/sceneAdapter";
import { mockScene, mockLeaderboard, mockReferenceNow } from "../lib/mockData";
import type { Scene as SceneData, LeaderboardRow } from "../lib/types";

const apiBaseUrl = import.meta.env.API_BASE_URL ?? "http://127.0.0.1:3001";

interface LiveData {
  scene: SceneData;
  leaderboard: LeaderboardRow[];
  referenceNow: Date;
}

// Fetches and adapts the real scene/leaderboard, or returns null (logging
// why) on any failure. Every failure mode below is a distinct, identifiable
// log line — network error, bad HTTP status, and malformed/unparseable body
// are different production problems and shouldn't share one vague message.
async function fetchLiveData(): Promise<LiveData | null> {
  let sceneRes: Response;
  let leaderboardRes: Response;
  try {
    [sceneRes, leaderboardRes] = await Promise.all([
      fetch(`${apiBaseUrl}/scene`),
      fetch(`${apiBaseUrl}/leaderboard`),
    ]);
  } catch (err) {
    console.warn(
      `[build] Could not reach the API at ${apiBaseUrl} (network error) — falling back to mock data:`,
      err instanceof Error ? err.message : err,
    );
    return null;
  }

  if (!sceneRes.ok || !leaderboardRes.ok) {
    console.warn(
      `[build] API at ${apiBaseUrl} responded with a non-OK status (scene: ${sceneRes.status}, leaderboard: ${leaderboardRes.status}) — falling back to mock data.`,
    );
    return null;
  }

  let liveScene: SceneData | null;
  let liveLeaderboard: LeaderboardRow[];
  try {
    const sceneJson = await sceneRes.json();
    const leaderboardJson = await leaderboardRes.json();
    liveScene = adaptScene(sceneJson);
    liveLeaderboard = leaderboardJson.map(adaptLeaderboardRow);
  } catch (err) {
    console.warn(
      `[build] API at ${apiBaseUrl} returned a malformed response body — falling back to mock data:`,
      err instanceof Error ? err.message : err,
    );
    return null;
  }

  if (!liveScene) {
    console.warn("[build] /scene returned no champion yet (engine not bootstrapped) — using mock data.");
    return null;
  }

  // referenceNow is only meaningful alongside a real scene: it's the instant
  // Scene.astro measures the champion's "time held" from, and pairing a real
  // scene with the mock's frozen referenceNow (or vice versa) would fabricate
  // a bogus duration. Bundled into the same object as scene/leaderboard so
  // the caller can only ever apply all three together, never some subset.
  return { scene: liveScene, leaderboard: liveLeaderboard, referenceNow: new Date() };
}

const live = await fetchLiveData();

// Single all-or-nothing assignment: either every one of scene/leaderboard/
// referenceNow comes from the live API, or all three stay on their mock
// defaults. Never a real scene rendered against mockReferenceNow, or a real
// scene paired with the mock leaderboard.
const scene: SceneData = live?.scene ?? mockScene;
const leaderboard: LeaderboardRow[] = live?.leaderboard ?? mockLeaderboard;
const referenceNow: Date = live?.referenceNow ?? mockReferenceNow;
---
<BaseLayout title="oneabobeall">
  <Scene scene={scene} referenceNow={referenceNow} />
  <AuctionFlow client:idle leaderboard={leaderboard} />
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import AuctionFlow from "../components/AuctionFlow";
import SiteFooter from "../components/SiteFooter.astro";
import AttributionTracker from "../components/AttributionTracker.astro";
import { adaptScene, adaptLeaderboardRow } from "../lib/sceneAdapter";
import { mockScene, mockLeaderboard, mockReferenceNow } from "../lib/mockData";
import type { Scene as SceneData, LeaderboardRow } from "../lib/types";

// Two different audiences, two different URLs — collapsing them into one
// caused a real production bug (2026-09-26): the browser tried to fetch
// the in-cluster Service hostname directly and failed, since that name
// only resolves inside the k8s network.
//
// API_BASE_URL: read only during `astro build` (below, in fetchLiveData),
// which runs inside the cluster (see infra/docker/rebuild-server.mjs) — an
// internal Service address like http://oneaboveall-api is correct and
// faster than round-tripping through the public domain and Traefik.
const buildTimeApiBaseUrl = import.meta.env.API_BASE_URL ?? "http://127.0.0.1:3001";

// PUBLIC_API_BASE_URL: baked into the static HTML and read by the browser
// itself (every fetch inside AuctionFlow.tsx and its children) — this must
// always be the API's public, TLS-fronted origin, never an internal
// cluster hostname the browser cannot resolve.
const publicApiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://127.0.0.1:3001";

// Strict mode for real deployments. This site's entire premise is "this is
// who actually paid the most", so silently publishing the nine fabricated
// mock people as the real champion and retinue — because the API container
// happened to be mid-restart during a CI build — is a data-integrity failure,
// not graceful degradation.
//
// Unset/falsy (the default) keeps the fallback: `astro dev` and a local
// `astro build` must work with no Postgres and no API running, which is the
// entire reason the mock fallback exists. A deployment pipeline sets
// REQUIRE_LIVE_DATA=true and every fallback trigger below becomes a hard
// build failure instead. See apps/web/.env.example.
//
// Stringified deliberately, and it matters. Astro's env plugin inlines a
// private env var differently depending on where it came from: a shell/CI
// variable whose value is exactly "true", "false", "0" or "1" is substituted
// as the *literal* `true`/`false`/`0`/`1` (so this reads as a boolean), while
// the same value coming from a .env file is substituted as the quoted string
// "true". A bare `=== "true"` therefore silently fails to arm strict mode for
// precisely the case that needs it most — `REQUIRE_LIVE_DATA=true astro build`
// in a pipeline — and the build would publish mock data believing it was
// protected. `String(...)` collapses both forms onto the same comparison.
const requireLiveData = String(import.meta.env.REQUIRE_LIVE_DATA) === "true";

interface LiveData {
  scene: SceneData;
  leaderboard: LeaderboardRow[];
  referenceNow: Date;
}

// The single gate every fallback trigger goes through: under strict mode it
// throws (failing the build, naming the condition that failed); otherwise it
// warns and signals "use mock data" to the caller by returning null.
//
// `reason` is always a complete, self-identifying description of *which*
// condition tripped — network error, bad HTTP status, malformed body and
// no-champion-yet are different production problems and must never collapse
// into one vague message, whether they end up in a warning or in a thrown
// build error.
function degradeToMock(reason: string): null {
  if (requireLiveData) {
    throw new Error(
      `[build] REQUIRE_LIVE_DATA=true, so mock data may not be published: ${reason}`,
    );
  }
  console.warn(`[build] ${reason} — falling back to mock data.`);
  return null;
}

// Fetches and adapts the real scene/leaderboard, or returns null on any
// failure (after routing that failure through `degradeToMock`, which either
// logs it or turns it into a build error).
async function fetchLiveData(): Promise<LiveData | null> {
  let sceneRes: Response;
  let leaderboardRes: Response;
  try {
    [sceneRes, leaderboardRes] = await Promise.all([
      fetch(`${buildTimeApiBaseUrl}/scene`),
      fetch(`${buildTimeApiBaseUrl}/leaderboard`),
    ]);
  } catch (err) {
    return degradeToMock(
      `could not reach the API at ${buildTimeApiBaseUrl} (network error: ${err instanceof Error ? err.message : String(err)})`,
    );
  }

  if (!sceneRes.ok || !leaderboardRes.ok) {
    return degradeToMock(
      `the API at ${buildTimeApiBaseUrl} responded with a non-OK status (scene: ${sceneRes.status}, leaderboard: ${leaderboardRes.status})`,
    );
  }

  let liveScene: SceneData | null;
  let liveLeaderboard: LeaderboardRow[];
  try {
    const sceneJson = await sceneRes.json();
    const leaderboardJson = await leaderboardRes.json();
    liveScene = adaptScene(sceneJson);
    liveLeaderboard = leaderboardJson.map(adaptLeaderboardRow);
  } catch (err) {
    // Reached both by unparseable JSON and by `adaptScene`/
    // `adaptLeaderboardRow` rejecting a structurally wrong payload (an
    // unparseable date, a non-array `retinue`). The adapters throw rather
    // than coercing precisely so that a malformed body lands here, instead
    // of producing an `Invalid Date` that crashes Scene.astro's formatters
    // further downstream — past this catch and past the strict-mode gate.
    return degradeToMock(
      `the API at ${buildTimeApiBaseUrl} returned a malformed response body (${err instanceof Error ? err.message : String(err)})`,
    );
  }

  if (!liveScene) {
    return degradeToMock(
      `the API at ${buildTimeApiBaseUrl} reports no champion yet on /scene (engine not bootstrapped)`,
    );
  }

  // referenceNow is only meaningful alongside a real scene: it's the instant
  // Scene.astro measures the champion's "time held" from, and pairing a real
  // scene with the mock's frozen referenceNow (or vice versa) would fabricate
  // a bogus duration. Bundled into the same object as scene/leaderboard so
  // the caller can only ever apply all three together, never some subset.
  return { scene: liveScene, leaderboard: liveLeaderboard, referenceNow: new Date() };
}

const live = await fetchLiveData();

// Single all-or-nothing assignment: either every one of scene/leaderboard/
// referenceNow comes from the live API, or all three stay on their mock
// defaults. Never a real scene rendered against mockReferenceNow, or a real
// scene paired with the mock leaderboard.
const scene: SceneData = live?.scene ?? mockScene;
const leaderboard: LeaderboardRow[] = live?.leaderboard ?? mockLeaderboard;
const referenceNow: Date = live?.referenceNow ?? mockReferenceNow;
---
<BaseLayout title="oneaboveall — One above all">
  <Scene scene={scene} referenceNow={referenceNow} />
  <!--
    AuctionFlow now also renders the account badge (the one deliberate live
    element on this otherwise fully static page — see UserBadge.tsx's own
    header comment) inside its own top-right chrome row, so the badge sits
    flush with the Light/Leaderboard chips instead of needing independent
    fixed-position math to line up with them.

    The headline "current price of the seat" is no longer seeded from
    `scene.champion.priceCents` here — AuctionFlow shows a spinner for it
    until its own live GET /current-round fetch resolves, rather than a
    build-time figure that could already be wrong by the time this page is
    viewed (see AuctionFlow.tsx's own comment on `liveLeaderCents`).
  -->
  <AuctionFlow client:idle leaderboard={leaderboard} apiBaseUrl={publicApiBaseUrl} />
  <SiteFooter />
  <AttributionTracker />
</BaseLayout>

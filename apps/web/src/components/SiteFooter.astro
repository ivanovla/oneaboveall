---
// Tiny legal/contact row for the homepage. Pinned to the bottom-right corner
// *inside* the 34px bottom padding of AuctionFlow's fixed auction bar, so it
// never overlaps the price / Displace button / countdown stack (which is
// centred above that padding) nor the top chrome chips. The bar's backdrop
// is always a dark gradient regardless of theme, hence the --on-scene-*
// colours (light in both themes) rather than --fg-*.
// z-index 16: just above the bar (15), below the top chrome (20) and every
// overlay (40+), so an open overlay covers it.
---
<nav class="site-footer" aria-label="Legal">
  <a href="/terms">Terms</a>
  <span aria-hidden="true">·</span>
  <a href="/privacy">Privacy</a>
  <span aria-hidden="true">·</span>
  <a href="mailto:oneabovealldotorg@gmail.com">Contact</a>
</nav>

<style>
  .site-footer {
    position: fixed;
    right: 14px;
    bottom: 9px;
    z-index: 16;
    display: flex;
    gap: 6px;
    align-items: center;
    font-size: 10px;
    letter-spacing: .08em;
    line-height: 1;
    color: var(--on-scene-faint);
    text-shadow: 0 1px 2px rgba(0, 0, 0, .6);
    pointer-events: none;
  }
  .site-footer a {
    color: var(--on-scene-dim);
    padding: 3px 0;
    pointer-events: auto;
  }
  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--on-scene);
  }
  @media (max-width: 480px) {
    .site-footer {
      right: 0;
      left: 0;
      justify-content: center;
      bottom: 7px;
    }
  }
</style>

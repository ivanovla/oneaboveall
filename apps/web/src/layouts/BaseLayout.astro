---
import "../styles/tokens.css";

const SITE_ORIGIN = "https://oneaboveall.org";
const DEFAULT_DESCRIPTION =
  "One page. One crowd. One above all. Outbid the person in the center and take their seat — you pay only if you win.";

interface Props {
  title: string;
  /** Meta / Open Graph / Twitter description. Falls back to the site tagline. */
  description?: string;
  /** Path (or absolute URL) of the link-preview image; must be 1200×630. */
  image?: string;
}
const { title, description = DEFAULT_DESCRIPTION, image = "/og.jpg" } = Astro.props;
// Link-preview crawlers need absolute URLs, and always the public origin —
// never whatever host the static build happened to run on.
const canonicalUrl = new URL(Astro.url.pathname, SITE_ORIGIN).href;
const imageUrl = new URL(image, SITE_ORIGIN).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="theme-color" content="#070603" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="oneaboveall" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600&family=Manrope:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <!--
      Applies a previously chosen theme before first paint, so a returning
      light-theme visitor never sees a flash of the dark palette. `is:inline`
      keeps it a blocking inline script in <head> rather than a bundled,
      deferred module. The storage key must match THEME_STORAGE_KEY in
      components/AuctionFlow.tsx, which owns the toggle itself.
    -->
    <script is:inline>
      try {
        if (localStorage.getItem("oneaboveall:theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch (e) {
        /* storage unavailable — fall back to the default dark theme */
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
